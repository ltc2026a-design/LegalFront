{
  "name": "legal-front",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema de Consulta Legal — proyecto publicado en Vercel (consulta + panel + API)",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @legal/consulta",
    "dev:consulta": "npm run dev --workspace @legal/consulta",
    "dev:admin": "npm run dev --workspace @legal/admin",
    "dev:api": "npm run dev --workspace @legal/backend",
    "build": "npm run build --workspace @legal/consulta",
    "build:consulta": "npm run build --workspace @legal/consulta",
    "build:admin": "npm run build --workspace @legal/admin",
    "build:api": "npm run build --workspace @legal/backend",
    "preview": "npm run preview --workspace @legal/consulta",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
