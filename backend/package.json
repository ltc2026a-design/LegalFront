{
  "name": "@legal/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "API Express del Sistema de Consulta Legal",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "db": "node scripts/db.mjs",
    "db:check": "node scripts/check-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "worker": "tsx src/sincronizacion/worker.ts",
    "sync": "tsx scripts/sync-run.ts",
    "importar": "tsx scripts/importar-canonical.ts",
    "importar:md": "tsx scripts/importar-lexmx.ts",
    "importar:poe": "tsx scripts/importar-poe.ts",
    "sync:qroo": "tsx scripts/actualizar-qroo.ts",
    "replicar": "tsx scripts/replicar-base.ts",
    "db:deploy": "prisma migrate deploy",
    "gen:vapid": "node scripts/gen-vapid.mjs",
    "admin:create": "tsx src/cli/crear-admin.ts",
    "usuario:create": "tsx src/cli/crear-usuario.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
