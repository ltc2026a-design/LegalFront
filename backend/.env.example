# Copia este archivo a backend/.env y ajusta los valores.
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@localhost:5544/legal

# Ruta absoluta SIN espacios ni caracteres no ASCII (obligatorio en Windows).
# Si se deja vacia, scripts/db.mjs elige una ruta segura automaticamente.
PGDATA_DIR=

# Zona 7 · autenticacion de administradores.
# JWT_SECRET: genera uno propio y NO lo subas a git (node -e "...randomBytes(48)...base64url").
JWT_SECRET=
JWT_EXPIRES=8h

# ---- Zona 9 · Web Push (VAPID autogestionado, sin cuenta externa) ----
# Claves VAPID generadas localmente con `node scripts/gen-vapid.mjs`
# (escribe ambas en backend/.env). La publica la consume la app para suscribirse;
# la privada NUNCA sale del servidor ni se sube a git.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Identificador de contacto que se envia al servicio de push (formato mailto: o https:).
VAPID_SUBJECT=mailto:admin@consulta-legal.local

# ---- Zona 12 · asistente de consultas con IA (opcional) ----
# Sin LLM_API_KEY el chat no aparece y la app usa la busqueda guiada: todo lo demas
# funciona igual. La llave NUNCA llega al navegador (la usa solo el backend).
# Gemini (gratis para empezar): https://aistudio.google.com/apikey
# Ojo: Google retira modelos viejos para llaves nuevas (404 "no longer available").
# Si eso pasa, cambia LLM_MODELO; `gemini-flash-latest` siempre apunta al vigente.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODELO=gemini-3.8-flash
# Para un proveedor compatible con OpenAI (OpenRouter, Groq, Ollama local...):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://openrouter.ai/api/v1     (defecto: https://api.openai.com/v1)
#   LLM_MODELO=gpt-4o-mini
# Cupos/ajustes:
# LLM_MAX_TOKENS=700        (maximo de caracteres-ia por respuesta)
# LLM_TIMEOUT_MS=45000      (abortar si el proveedor se cuelga)
# RATE_LIMIT_ASISTENTE_MAX=20  (preguntas por IP+dispositivo cada 15 min)

