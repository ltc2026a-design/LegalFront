# Copiame como apps/consulta/.env y apps/admin/.env (cada proyecto usa su propio archivo).
# En Vercel NO hace falta este archivo: se configura la variable en
# Project Settings -> Environment Variables.

# URL publica del backend (Render). Sin esta variable el front apunta a
# http://localhost:3000/api, que solo sirve en desarrollo local.
VITE_API_URL=https://TUS-SERVICIO.onrender.com/api
