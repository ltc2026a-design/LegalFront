# Copiame como apps/consulta/.env y apps/admin/.env (cada proyecto usa su propio archivo).
# En Vercel NO hace falta este archivo: se configura la variable en
# Project Settings -> Environment Variables.

# URL publica del backend (Render). Sin esta variable el front apunta a
# http://localhost:3000/api, que solo sirve en desarrollo local.
VITE_API_URL=https://TUS-SERVICIO.onrender.com/api

# Live Updates del APK: URL publica de esta app + /live-updates/check.json.
# Solo la consume el build nativo (el APK la lleva quemada); en el sitio web no se usa.
# Con `npm run live:publicar` se generan el manifiesto y el zip que Vercel sirve aqui.
VITE_LIVE_UPDATE_URL=https://TU-FRONT.vercel.app/live-updates/check.json

# Unicamente para el panel (apps/admin): prefijo bajo el que se sirve. En el proyecto
# de Vercel en modo services el panel vive en /panel/, asi que alla VITE_BASE=/panel/.
# En local y en Render se deja vacio (el panel va en la raiz de su propio sitio).
# VITE_BASE=/panel/
